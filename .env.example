# The demo branch needs no environment variables: there is no database, and
# the guest demo never calls Gemini. Everything below is optional.

# Base URL of the site, used to build auth redirect links
# (Netlify sets it in netlify.toml)
NEXT_PUBLIC_SITE_URL=

# Read only by the AI routes, which refuse guest demo requests, so the demo
# never uses them. Kept so the code matches the main branch.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=
