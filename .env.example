# Copy to .env.local and fill in. Values for a local stack are printed by
# `npx supabase status`.

# --- Required ---

# Supabase API URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key; safe in the browser because every table uses RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of this app, used for auth redirects (local: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# --- Optional ---

# Shared Gemini key. Without it the tools return bundled sample images.
GOOGLE_GENERATIVE_AI_API_KEY=
# Override the default Gemini models
GEMINI_TEXT_MODEL=
GEMINI_IMAGE_MODEL=

# --- Seed (npm run seed only, never exposed to the app) ---

# Supabase service role key; bypasses RLS, keep it out of the browser
SUPABASE_SERVICE_ROLE_KEY=
# Login for the seeded sample account. Required for a hosted project; a local
# Supabase falls back to the local-only defaults in supabase/seed.mjs.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
